# Copy to .env.local for local development. Deployed builds read .env.staging or
# .env.production, selected by the --mode flag (see the build scripts in package.json).

# Backend API base. MUST include the /api/v1 prefix: request paths begin at /admin/...
# Leaving this unset falls back to a relative /api, which resolves to the dashboard's
# own host and silently talks to nothing.
VITE_API_BASE_URL=

# Firebase Web app config for the project this dashboard signs in against.
#
# These values are public by design — they are compiled into the bundle any visitor
# can read, and Google documents them as non-secret identifiers. They grant nothing
# on their own: signing in yields a Firebase token, and the backend exchanges it for
# an admin session only if that email exists in admin_users. Access is controlled
# there, not here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Recorded for reference; the dashboard does not read it. The signInWithPopup flow
# derives its OAuth client from authDomain. Kept here because the mobile app needs
# this exact value and it is otherwise easy to lose.
VITE_GOOGLE_WEB_CLIENT_ID=

# Set to exactly "true" to render built-in fixture data instead of calling the API.
# Local UI work only. Any other value — including unset — uses the real API and lets
# failures surface as errors.
VITE_USE_MOCK_API=

# staging | production | local. Shown in the UI and used to detect a build whose
# settings contradict its declared environment.
VITE_APP_ENV=

# Set to "true" to offer Apple sign-in. The API accepts Apple already; the popup fails
# until Apple is enabled in the Firebase project.
VITE_ENABLE_APPLE_SIGNIN=
