# API (must include /api/v1)
# Dev: http://localhost:3000/api/v1 — Prod: https://<your-api-host>/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Firebase (Google OAuth for admin sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Optional — Socket.io origin for Live Refresh (defaults to API host without /api/v1)
# VITE_SOCKET_URL=http://localhost:3000

# Optional — Stripe Connect transfers dashboard base for payout deep-links
# VITE_STRIPE_DASHBOARD_BASE=https://dashboard.stripe.com/connect/transfers

# staging | production | local. Shown in the UI and used to detect a build whose
# settings contradict its declared environment. Deployed builds set this via
# .env.staging / .env.production.
VITE_APP_ENV=
