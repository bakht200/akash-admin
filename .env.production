# Production build — `npm run build:production`
#
# INCOMPLETE. Two values are still unknown and are marked TODO below. Building with
# them empty produces a dashboard that looks normal and cannot sign anyone in.

# Production API. The hostname is reserved but not yet serving — it is stood up when
# the production load balancer exists.
VITE_API_BASE_URL=https://api.akashtherapies.com/api/v1

# Firebase Web app in akash-prod. Public values — see .env.example.
VITE_FIREBASE_API_KEY=AIzaSyBqsXcbXK2dD3oj6HOTH3X7-es4DIgfayU
VITE_FIREBASE_AUTH_DOMAIN=akash-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=akash-prod
VITE_FIREBASE_APP_ID=1:711958023759:web:eb377babdfd6e63840243a
VITE_FIREBASE_MESSAGING_SENDER_ID=711958023759

# TODO — from akash-prod: Authentication > Sign-in method > Google > Web SDK configuration.
# Not read by the dashboard; recorded so it is not lost. The mobile app needs it.
VITE_GOOGLE_WEB_CLIENT_ID=

# Real API, real errors.
VITE_USE_MOCK_API=false

# Names this build in the UI so staging and production are never confused.
VITE_APP_ENV=production

# Apple sign-in: the API already accepts it; enable once Apple is turned on in the
# akash-prod Firebase project and a Services ID + key exist on the Apple Developer side.
VITE_ENABLE_APPLE_SIGNIN=false
