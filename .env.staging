# Staging build — `npm run build:staging`
#
# Note the naming: staging's Firebase project is called akash-dev-999d6 and its AWS
# resources are named akash-dev-*. That is historical naming, not a separate "dev"
# environment. There is no deployed dev. This file configures STAGING.

# Staging API. Currently served by the existing CloudFront distribution; this becomes
# https://api-staging.akashtherapies.com once that hostname is attached as an alias.
# Both answer simultaneously, so switching is a one-line change with no cutover.
VITE_API_BASE_URL=https://ds26o2otimehm.cloudfront.net/api/v1

# Firebase Web app in akash-dev-999d6. Public values — see .env.example.
VITE_FIREBASE_API_KEY=AIzaSyAiNTx_tltX-d-PQR0SACndIO9jh05wzDU
VITE_FIREBASE_AUTH_DOMAIN=akash-dev-999d6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=akash-dev-999d6
VITE_FIREBASE_APP_ID=1:750165727081:web:6bb1de701c8eb1a1e8cff8
VITE_FIREBASE_MESSAGING_SENDER_ID=750165727081

# Not read by the dashboard; recorded so it is not lost. The mobile app needs it.
VITE_GOOGLE_WEB_CLIENT_ID=750165727081-aoa29cfekbisiiufagf2g4bm5sb66a42.apps.googleusercontent.com

# Real API, real errors.
VITE_USE_MOCK_API=false

# Names this build in the UI so staging and production are never confused.
VITE_APP_ENV=staging

# Apple sign-in: the API already accepts it; enable once Apple is turned on in the
# Firebase project and a Services ID + key exist on the Apple Developer side.
VITE_ENABLE_APPLE_SIGNIN=false
